{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "6.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "Pro-Bandey",
  "homepage_url": "https://Pro-Bandey.github.io/?rdm=Adaptive-Tab-Theme",

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "64": "icons/64.png",
      "128": "icons/128.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },

  "permissions": ["tabs", "theme", "storage", "browserSettings", "management"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["adaptiveTheme.js"]
    }
  ],

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "adaptive-tab-theme@mrc.com",
      "strict_min_version": "112.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
